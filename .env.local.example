# Copy this file to .env.local (for local dev) and set the same variables
# in your Vercel project settings (for deployment).
#
# Get both from your Supabase project: Settings -> API.
#
# SUPABASE_ANON_KEY is the PUBLIC anon/publishable key -- safe to ship to
# the browser, it has no special privileges on its own. Access control is
# enforced entirely by the Row Level Security policies in
# supabase/schema.sql, keyed off the signed-in user's session (which
# @supabase/ssr manages via cookies). Do NOT use the service_role key
# here -- that would bypass RLS entirely and let any signed-in user read
# or write anyone else's data.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Without these, the in-app Feedback form still works and every
# submission is saved to the planner_feedback table (visible at /admin to an
# admin, or in the Supabase table editor) -- these two just ALSO send a copy
# by email. Get a free key at https://resend.com, then verify a sending
# domain (or use their default onboarding@resend.dev for testing only).
# See README.md "Feedback email" for the full walkthrough.
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM_EMAIL=Planner Feedback <feedback@yourdomain.com>
